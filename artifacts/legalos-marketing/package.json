{
  "name": "@workspace/uvid-marketing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:firms": "node scripts/generate-tracked-firms.mjs",
    "generate:guidebook": "node scripts/generate-guidebook-meta.mjs",
    "generate:benchmarks": "node scripts/generate-benchmarks.mjs",
    "generate:leaders": "node scripts/generate-benchmark-leaders.mjs",
    "test:benchmarks": "node --test scripts/generate-benchmarks.test.mjs",
    "test:leaders": "node --test scripts/generate-benchmark-leaders.test.mjs scripts/generate-benchmark-leaders.e2e.test.mjs",
    "check:firms": "node scripts/generate-tracked-firms.mjs && git diff --exit-code src/data/trackedFirms.ts || (echo 'ERROR: src/data/trackedFirms.ts is stale — run pnpm run generate:firms and commit the result.' && exit 1)",
    "check:guidebook": "node scripts/generate-guidebook-meta.mjs && git diff --exit-code src/data/guidebookMeta.ts || (echo 'ERROR: src/data/guidebookMeta.ts is stale — run pnpm run generate:guidebook and commit the result.' && exit 1)",
    "check:leaders": "node scripts/generate-benchmark-leaders.mjs && git diff --exit-code src/data/benchmarkLeaders.ts || (echo 'ERROR: src/data/benchmarkLeaders.ts is stale — run pnpm run generate:leaders and commit the result.' && exit 1)",
    "check:cohort": "node scripts/check-firm-cohort.mjs",
    "check:palette": "node scripts/check-palette.mjs",
    "check:root-meta": "node scripts/check-root-meta.mjs",
    "test:cohort": "node --test scripts/check-firm-cohort.test.mjs scripts/firm-check-status.test.mjs",
    "test:firms": "node --test scripts/generate-tracked-firms.test.mjs",
    "test:guidebook": "node --test scripts/generate-guidebook-meta.test.mjs",
    "test:ctas": "node --test scripts/cta-destinations.test.mjs",
    "predev": "node scripts/generate-tracked-firms.mjs && node scripts/generate-guidebook-meta.mjs && node scripts/generate-benchmark-leaders.mjs",
    "prebuild": "node scripts/generate-tracked-firms.mjs && node scripts/generate-guidebook-meta.mjs && node scripts/generate-benchmark-leaders.mjs && node scripts/check-firm-cohort.mjs && node --test scripts/cta-destinations.test.mjs && node scripts/check-palette.mjs && node scripts/check-root-meta.mjs",
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:mobile": "node tests/mobile-smoke.mjs"
  },
  "devDependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-alert-dialog": "^1.1.7",
    "@radix-ui/react-aspect-ratio": "^1.1.3",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-collapsible": "^1.1.4",
    "@radix-ui/react-context-menu": "^2.2.7",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-hover-card": "^1.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-menubar": "^1.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.6",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-progress": "^1.1.3",
    "@radix-ui/react-radio-group": "^1.2.4",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slider": "^1.2.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-toggle": "^1.1.3",
    "@radix-ui/react-toggle-group": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@replit/vite-plugin-cartographer": "catalog:",
    "@replit/vite-plugin-dev-banner": "catalog:",
    "@replit/vite-plugin-runtime-error-modal": "catalog:",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "catalog:",
    "input-otp": "^1.4.2",
    "lucide-react": "catalog:",
    "next-themes": "^0.4.6",
    "playwright-core": "^1.62.0",
    "react": "catalog:",
    "react-day-picker": "^9.11.1",
    "react-dom": "catalog:",
    "react-hook-form": "^7.55.0",
    "react-icons": "^5.4.0",
    "react-resizable-panels": "^2.1.7",
    "recharts": "^2.15.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "vite": "catalog:",
    "wouter": "^3.3.5",
    "zod": "catalog:"
  }
}
